{
  "$schema": "https://biomejs.dev/schemas/1.8.1/schema.json",
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true
  },
  "organizeImports": {
    "enabled": true
  },
  "files": {
    "ignore": [
      "**/node_modules/**",
      "**/.next/**",
      "**/.turbo/**",
      "**/dist/**",
      "**/build/**",
      "**/drizzle/**",
      "**/coverage/**",
      "**/bun.lock",
      "**/pnpm-lock.yaml",
      "**/package-lock.json",
      "**/tsconfig.tsbuildinfo"
    ]
  }
}
