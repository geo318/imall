FROM oven/bun:1.3.0 AS build
WORKDIR /app

# Install deps (workspace-aware)
COPY package.json bun.lock turbo.json tsconfig.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/api/package.json apps/api/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY packages/typescript-config/package.json packages/typescript-config/package.json
RUN bun install --frozen-lockfile

# Build web + shared packages
# Clerk requires a valid publishableKey during prerender. Render auto-translates env vars to build args,
# so set NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY in the Render dashboard (Environment) for emakret-web.
COPY . .
RUN bun run build:packages
ARG NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
ENV NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=$NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
ENV DOMAIN=https://placeholder.example.com
ENV DATABASE_URL=postgresql://localhost:5432/placeholder
ENV CLERK_SECRET_KEY=sk_build_placeholder
ENV NEXT_PUBLIC_DOMAIN=https://placeholder.example.com
ENV SUPERADMIN_EMAIL=build@example.com
ENV SUPERADMIN_PASSWORD=build-placeholder
RUN bun run build:web

FROM oven/bun:1.3.0 AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000

COPY --from=build /app/node_modules /app/node_modules
COPY --from=build /app/apps/web /app/apps/web
COPY --from=build /app/packages /app/packages
COPY --from=build /app/package.json /app/package.json

WORKDIR /app/apps/web
EXPOSE 3000
CMD ["bun", "run", "--bun", "next", "start"]
