  "faq": {
    "eyebrow": "FAQ",
    "title": "Frequently Asked Questions",
    "lead": "Everything you need to know about accounts, orders, auctions, and legal policies on iMall.",
    "leadLink": "Review legal policies",
    "entries": [
      {
        "q": "Do I buy products from iMall directly?",
        "a": "Usually no. iMall is a marketplace where third-party vendors sell products. Your purchase agreement is with the vendor unless a product is marked as sold by iMall."
      },
      {
        "q": "How do returns work?",
        "a": "Returns follow each vendor's policy. Most sellers offer up to 30 days. For EU deliveries, the 14-day cooling-off right applies where required by law."
      },
      {
        "q": "Can I cancel an order after payment?",
        "a": "If the order has not shipped, contact the vendor immediately via iMall messages. Once shipped, cancellation may be handled as a return request."
      },
      {
        "q": "Are auctions available for every product?",
        "a": "No. Auctions are enabled per seller and product category. Bids must meet the minimum increment shown on the product page."
      },
      {
        "q": "Do I need an account to buy?",
        "a": "Guest browsing is available, but signing in gives you favorites, faster checkout, order history, and easier support."
      },
      {
        "q": "Who should I contact for disputes or data requests?",
        "a": "Start with the vendor for order-specific issues. For privacy or platform-level requests, email contact@imall.ge."
      }
    ]
  },
