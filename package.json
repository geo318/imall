{
  "name": "myshop",
  "private": true,
  "scripts": {
    "build": "bun run render:build",
    "build:all": "turbo run build",
    "build:web": "turbo run build --filter=web",
    "build:api": "turbo run build --filter=api",
    "build:packages": "turbo run build --filter=@repo/*",
    "start": "bun run render:start",
    "start:all": "turbo run start --filter=api --filter=web --parallel",
    "start:web": "turbo run start --filter=web",
    "start:api": "turbo run start --filter=api",
    "render:build": "bun scripts/render.mjs build",
    "render:start": "bun scripts/render.mjs start",
    "build:start": "bun run build && bun run start",
    "build:start:with-db": "bun run db:docker && bun run db:push && bun run build:start",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:api": "turbo run dev --filter=api",
    "dev:all": "turbo run build --filter=@repo/db && turbo run dev --filter=api --filter=web --parallel",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:push": "drizzle-kit push --config drizzle.config.ts",
    "db:push:ci": "drizzle-kit push --config drizzle.config.ts --force",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "db:docker": "docker compose up --build -d db",
    "db:studio:docker": "docker compose up --build -d db && bun run db:push && bun run db:studio",
    "dev:with-db": "docker compose up --build -d db && bun run db:push && bun run dev:all",
    "seed:with-db": "docker compose up --build -d db && bun run db:push && bun run seed",
    "seed:categories": "bun scripts/seed-categories.ts",
    "lint": "turbo run lint",
    "lint:biome": "biome check .",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:biome": "biome check --write .",
    "check-types": "turbo run check-types",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "seed": "bun run scripts/seed.ts",
    "db:fix-categories": "bun run scripts/fix-null-categories.ts",
    "images:cleanup": "bun run scripts/cleanup-image-storage.ts",
    "images:cleanup:apply": "bun run scripts/cleanup-image-storage.ts --apply"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "prettier": "^3.7.4",
    "turbo": "^2.7.2",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-select": "^2.2.6",
    "@tanstack/react-form": "^1.27.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "axios": "^1.13.2",
    "lucide-react": "^0.562.0",
    "next-intl": "^4.8.2",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.71.1",
    "react-markdown": "^10.1.0",
    "react-share": "^5.2.2",
    "react-syntax-highlighter": "^16.1.0"
  }
}
