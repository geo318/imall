{
  "name": "myshop",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev --filter=web",
    "dev:api": "turbo run dev --filter=api",
    "dev:all": "turbo run dev --filter=api --filter=web --parallel",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:push": "drizzle-kit push --config drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "db:docker": "docker compose up --build -d db",
    "db:studio:docker": "docker compose up --build -d db && bun run db:push && bun run db:studio",
    "dev:with-db": "docker compose up --build -d db && bun run db:push && bun run dev:all",
    "seed:with-db": "docker compose up --build -d db && bun run db:push && bun run seed",
    "lint:biome": "biome check .",
    "format:biome": "biome check --apply .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "seed": "bun run scripts/seed.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.3",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "prettier": "^3.7.4",
    "turbo": "^2.7.2",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.0",
  "workspaces": ["apps/*", "packages/*"],
  "dependencies": {
    "@tanstack/react-form": "^1.27.7",
    "axios": "^1.13.2",
    "lucide-react": "^0.562.0"
  }
}
