# Core URLs
DOMAIN=http://localhost:3001
NEXT_PUBLIC_DOMAIN=http://localhost:3001

# Database
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/myshop
PORT=3001
DB_POOL_MAX=5
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
API_RESPONSE_CACHE_ENABLED=true
API_RESPONSE_CACHE_MAX_ENTRIES=2000
PRODUCT_STATS_FLUSH_INTERVAL_MS=2000
PRODUCT_STATS_MAX_PENDING_PRODUCTS=5000

# Auth (Clerk) – optional until roles/auth are wired
CLERK_JWT_PUBLIC_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Payments & webhooks (placeholders)
PAYMENT_KEEPZ_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Credo installments (optional, required only when installments are enabled)
CREDO_MERCHANT_ID=
CREDO_SHARED_SECRET=
# Override only if Credo provides a different endpoint/version
CREDO_WIDGET_ORDER_URL=https://ganvadeba.credo.ge/widget_api/order.php
CREDO_WIDGET_STATUS_URL=https://ganvadeba.credo.ge/widget/api.php
CREDO_INSTALLMENT_DEFAULT_MONTHS=12

# Superadmin (required)
SUPERADMIN_EMAIL=123@123.ge
SUPERADMIN_PASSWORD=12345678

# Seeding (optional)
SEED_SHOP_SLUG=demo-shop
SEED_SHOP_NAME=Demo Shop

# Image storage
# local | cloudinary
IMAGE_STORAGE_PROVIDER=local
# Preferred (single value)
CLOUDINARY_URL=
# Optional fallback (use only if CLOUDINARY_URL is not set)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BASE_FOLDER=imall
CLOUDINARY_DELIVERY_TRANSFORMATION=f_auto,q_auto
