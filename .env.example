# Next.js cache
# Set to false to disable auto PPR/cacheComponents (use cache directives remain as no-ops).
# Required when any RSC in the tree calls dynamic APIs (cookies, headers, auth) — those
# components throw DYNAMIC_SERVER_USAGE under cacheComponents:true.
NEXT_CACHE_COMPONENTS=false

# Core URLs
DOMAIN=http://localhost:3001
NEXT_PUBLIC_DOMAIN=http://localhost:3001

# Database
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/myshop
PORT=3001
DB_POOL_MAX=5
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
API_RESPONSE_CACHE_ENABLED=true
API_RESPONSE_CACHE_MAX_ENTRIES=2000
PRODUCT_STATS_FLUSH_INTERVAL_MS=2000
PRODUCT_STATS_MAX_PENDING_PRODUCTS=5000

# Auth (Clerk) – optional until roles/auth are wired
CLERK_JWT_PUBLIC_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Payments & webhooks (placeholders)
PAYMENT_KEEPZ_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Keepz eCommerce integration (optional, required for Keepz online card/installment flows)
# If your provider confirmed shared Credo merchant credentials, missing
# KEEPZ_INTEGRATOR_* / KEEPZ_RECEIVER_ID values fallback to CREDO_MERCHANT_ID
# only when CREDO_MERCHANT_ID is UUID v4 (Keepz requirement).
KEEPZ_ECOMMERCE_BASE_URL=https://gateway.dev.keepz.me/ecommerce-service
# UUID v4 issued by Keepz
KEEPZ_INTEGRATOR_IDENTIFIER=
# UUID v4 issued by Keepz
KEEPZ_INTEGRATOR_ID=
# UUID v4 issued by Keepz
KEEPZ_RECEIVER_ID=
# DER-base64 or PEM (-----BEGIN PUBLIC KEY----- ... -----END PUBLIC KEY-----)
KEEPZ_RSA_PUBLIC_KEY=
# DER-base64 or PEM (-----BEGIN PRIVATE KEY----- ... -----END PRIVATE KEY-----)
KEEPZ_RSA_PRIVATE_KEY=
KEEPZ_DEFAULT_DIRECT_LINK_PROVIDER=DEFAULT
KEEPZ_DEFAULT_LANGUAGE=KA
# Optional static callback endpoint override; dynamic fallback is derived from BACKEND_URL.
KEEPZ_CALLBACK_URL=
# Optional local pre-check range (Keepz default documented range: 1.1-3000.0 GEL).
KEEPZ_MIN_ORDER_AMOUNT=1.1
KEEPZ_MAX_ORDER_AMOUNT=3000

# Keepz Direct Settlements (optional, separate from eCommerce checkout flow)
KEEPZ_DIRECT_SETTLEMENTS_BASE_URL=https://distributor.dev.keepz.me
# UUID v4 issued by Keepz for Direct Settlements OAuth
KEEPZ_DIRECT_SETTLEMENTS_CLIENT_ID=
# Secret issued by Keepz for Direct Settlements OAuth
KEEPZ_DIRECT_SETTLEMENTS_CLIENT_SECRET=

# Credo installments (optional, required only when installments are enabled)
CREDO_MERCHANT_ID=
CREDO_SHARED_SECRET=
# Optional Keepz fallback aliases (used only when KEEPZ_RSA_* are unset)
CREDO_RSA_PUBLIC_KEY=
CREDO_RSA_PRIVATE_KEY=
# Optional persistent file path for auto-generated Keepz/Credo RSA keypair.
# Defaults to /var/data/keepz-rsa-keys.env on Render API, or .env locally.
KEEPZ_RSA_STATE_FILE=
# Override only if Credo provides a different endpoint/version
CREDO_WIDGET_ORDER_URL=https://ganvadeba.credo.ge/widget_api/order.php
CREDO_WIDGET_STATUS_URL=https://ganvadeba.credo.ge/widget/api.php
CREDO_INSTALLMENT_DEFAULT_MONTHS=12
# Password gating /custom-checkout?pass=... (ad-hoc Credo installment checkout, no catalog needed)
CUSTOM_CHECKOUT_PASS=

# Superadmin (required)
SUPERADMIN_EMAIL=123@123.ge
SUPERADMIN_PASSWORD=12345678

# Seeding (optional)
SEED_SHOP_SLUG=demo-shop
SEED_SHOP_NAME=Demo Shop

# Image storage
# local | cloudinary
IMAGE_STORAGE_PROVIDER=local
# Preferred (single value)
CLOUDINARY_URL=
# Optional fallback (use only if CLOUDINARY_URL is not set)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BASE_FOLDER=imall
CLOUDINARY_DELIVERY_TRANSFORMATION=f_auto,q_auto
