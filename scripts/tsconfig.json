{
  "extends": "../packages/typescript-config/base.json",
  "compilerOptions": {
    "baseUrl": "..",
    "module": "es2022",
    "moduleResolution": "node",
    "types": ["bun-types", "node"],
    "typeRoots": [
      "../apps/api/node_modules",
      "../apps/api/node_modules/@types",
      "../packages/db/node_modules/@types",
      "../packages/shared/node_modules/@types",
      "../node_modules/@types"
    ],
    "skipLibCheck": true,
    "paths": {
      "@repo/db": ["./packages/db/src/index.ts"],
      "@repo/db/*": ["./packages/db/src/*"],
      "@repo/shared": ["./packages/shared/src/index.ts"],
      "@repo/shared/*": ["./packages/shared/src/*"],
      "@t3-oss/env-core": ["./packages/shared/node_modules/@t3-oss/env-core/dist/index.d.ts"],
      "drizzle-orm": ["./packages/db/node_modules/drizzle-orm"],
      "drizzle-orm/*": ["./packages/db/node_modules/drizzle-orm/*"]
    }
  },
  "include": ["./seed.ts", "./cleanup-image-storage.ts"]
}
